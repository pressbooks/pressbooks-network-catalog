{
  "name": "pressbooks-network-catalog",
  "description": "A plugin which provides an improved catalog for the Pressbooks Aldine theme",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "pressbooks-build-tools build",
    "watch": "pressbooks-build-tools dev",
    "lint:scripts": "pressbooks-build-tools lint:scripts 'assets/js/**/*.js'",
    "lint:styles": "pressbooks-build-tools lint:styles 'assets/css/**/*.css'",
    "fix:scripts": "pressbooks-build-tools fix:scripts 'assets/js/**/*.js'",
    "fix:styles": "pressbooks-build-tools fix:styles 'assets/css/**/*.css'",
    "lint": "npm run lint:scripts && npm run lint:styles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pressbooks/pressbooks-network-catalog.git"
  },
  "keywords": [
    "wordpress-plugin"
  ],
  "author": "Pressbooks (Book Oven Inc.)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/pressbooks/pressbooks-network-catalog/issues"
  },
  "homepage": "https://github.com/pressbooks/pressbooks-network-catalog#readme",
  "devDependencies": {
    "pressbooks-build-tools": "^5.1.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "postcss-nested": "^6.0.1",
    "tailwindcss": "^3.3.3"
  },
  "dependencies": {
    "@duetds/date-picker": "^1.4.0",
    "alpinejs": "^3.14.0",
    "dayjs": "^1.11.11",
    "nanobar": "^0.4.2"
  },
  "eslintConfig": {
    "extends": "./node_modules/pressbooks-build-tools/config/eslint.cjs"
  },
  "stylelint": {
    "extends": "./node_modules/pressbooks-build-tools/config/stylelint.js"
  }
}
